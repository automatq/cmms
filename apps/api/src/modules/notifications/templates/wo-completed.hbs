<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #1a1a1a;">Work Order {{newStatus}}</h2>
  <p>Work order <strong>{{woNumber}}</strong> has been marked as <strong>{{newStatus}}</strong>.</p>
  <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
    <tr><td style="padding: 8px 0; color: #666;">Title</td><td style="padding: 8px 0;">{{title}}</td></tr>
    <tr><td style="padding: 8px 0; color: #666;">Previous Status</td><td style="padding: 8px 0;">{{oldStatus}}</td></tr>
  </table>
  <a href="{{appUrl}}/dashboard/work-orders/{{woId}}" style="display: inline-block; padding: 10px 20px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 6px;">View Details</a>
</div>
