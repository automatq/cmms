<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #1a1a1a;">{{authorName}} mentioned you</h2>
  <p>You were mentioned in a comment on a work order:</p>
  <blockquote style="margin: 16px 0; padding: 12px 16px; border-left: 3px solid #2563eb; background: #f8fafc; color: #334155;">{{snippet}}</blockquote>
  <a href="{{appUrl}}/dashboard/work-orders/{{woId}}" style="display: inline-block; padding: 10px 20px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 6px;">View Work Order</a>
</div>
