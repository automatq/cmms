# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cmms
DB_PASSWORD=cmms_secret_password
DB_DATABASE=cmms
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Storage (s3 or minio)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=cmms_minio
MINIO_SECRET_KEY=cmms_minio_secret
MINIO_BUCKET=cmms-files
MINIO_USE_SSL=false
# For S3 in production:
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=cmms-files

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cmms.local

# Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# App
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
NODE_ENV=development
