# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nexly
DB_PASSWORD=cmms_secret_password
DB_DATABASE=nexly
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Default tenant/user (no auth mode)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002
DEFAULT_USER_EMAIL=admin@local

# Storage (s3 or minio)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=nexly-files
MINIO_USE_SSL=false
# Either MINIO_ACCESS_KEY / MINIO_SECRET_KEY or
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD can be used.
MINIO_ACCESS_KEY=nexly_minio
MINIO_SECRET_KEY=nexly_minio_secret
MINIO_ROOT_USER=nexly_minio
MINIO_ROOT_PASSWORD=nexly_minio_secret
# For S3 in production:
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=nexly-files

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexly.local

# Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# App
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
NODE_ENV=development
