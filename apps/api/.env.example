# Local development: API on the host (`npm run dev:api`), backing services from
# `docker compose up -d postgres redis minio mailpit`. Values below match the
# defaults in the root .env.example — keep them in sync if you change those.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=maintek
DB_PASSWORD=maintek_secret
DB_DATABASE=maintek
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
# Migrations run automatically at startup; set to false to run them manually.
# DB_RUN_MIGRATIONS=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Auth (Better Auth) — REQUIRED. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the API is reachable, and where the web app is (used for auth
# redirects and links in emails).
BETTER_AUTH_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Storage (s3 or minio)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=maintek-files
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=maintek_minio
MINIO_SECRET_KEY=minio_secret
# For S3 in production:
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=maintek-files

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Email — Mailpit captures everything; view it at http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@maintek.app

# AI Assistant provider.
# Precedence: AI_PROVIDER (if set) wins; otherwise Anthropic is used when
# ANTHROPIC_API_KEY is present, else Ollama (local).
#   AI_PROVIDER=anthropic|bedrock|ollama
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Ollama (`docker compose --profile ai up -d ollama`):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Webhooks: allow http:// and private/LAN targets while developing.
WEBHOOK_ALLOW_HTTP=true
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# App
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
NODE_ENV=development
