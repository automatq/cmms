# Production Environment Configuration for CMMS
# Copy this file to .env and fill in your actual values

# ==========================================
# Application Settings
# ==========================================

# Public URL where the application will be accessible
# Examples: https://cmms.example.com, https://192.168.1.100
PUBLIC_URL=https://your-domain.com

# JWT Secret for API authentication (generate a strong random string)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Docker Registry Configuration
# Format: registry.example.com or registry.example.com/namespace
REGISTRY=your-registry.com/cmms

# Image tag to deploy (e.g., v1.0.0, latest)
TAG=latest

# ==========================================
# Database Configuration
# ==========================================

POSTGRES_USER=cmms
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=cmms

# ==========================================
# Keycloak Configuration
# ==========================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-to-a-strong-password

# ==========================================
# MinIO (S3-compatible storage) Configuration
# ==========================================

MINIO_ROOT_USER=cmms_minio
MINIO_ROOT_PASSWORD=change-this-to-a-strong-password

# ==========================================
# Email Configuration (Optional)
# ==========================================

# For production, configure your SMTP server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# For testing/development, use Mailpit (included in docker-compose)
SMTP_HOST=mailpit
SMTP_PORT=1025

# ==========================================
# pgAdmin Configuration (Debug profile only)
# ==========================================

PGADMIN_EMAIL=admin@cmms.local
PGADMIN_PASSWORD=change-this-password
