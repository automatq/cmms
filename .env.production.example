# Production Environment Configuration for Nexly
# Copy this file to .env and fill in your actual values
#
# Railway deployment:
#   DATABASE_URL and REDIS_URL are auto-injected by Railway plugins.
#   Set other vars as Railway service variables or shared variables.

# ==========================================
# Application Settings
# ==========================================

# Public URL where the application will be accessible
PUBLIC_URL=https://your-domain.com

# JWT Secret for API authentication (generate a strong random string)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==========================================
# Database Configuration
# ==========================================

# Railway: DATABASE_URL is auto-injected — no need to set these individually.
# Docker/self-hosted: set individual vars below.
# DATABASE_URL=postgresql://user:pass@host:5432/nexly
POSTGRES_USER=nexly
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=nexly

# ==========================================
# Redis Configuration
# ==========================================

# Railway: REDIS_URL is auto-injected — no need to set these individually.
# Docker/self-hosted: set individual vars below.
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-to-a-strong-password

# ==========================================
# Auth0 Configuration
# ==========================================

# API (NestJS backend)
AUTH0_DOMAIN=dev-am4jwp1t54ihh688.ca.auth0.com
AUTH0_AUDIENCE=https://api.nexly.app

# Web (Next.js frontend)
AUTH0_CLIENT_ID=your-web-client-id
AUTH0_CLIENT_SECRET=your-web-client-secret
AUTH0_SECRET=generate-with-openssl-rand-hex-32
AUTH0_ORGANIZATION=org_75uuBCMN90ReoPfQ
APP_BASE_URL=https://your-domain.com

# ==========================================
# Storage Configuration
# ==========================================

# For AWS S3 (production):
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=your-nexly-files-bucket

# For MinIO on Railway private networking:
# Create a MinIO service in the same Railway environment, attach a volume,
# and set the API service vars roughly like:
# STORAGE_PROVIDER=minio
# MINIO_ENDPOINT=${{MinIO.RAILWAY_PRIVATE_DOMAIN}}
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_BUCKET=nexly-files
# MINIO_ROOT_USER=${{MinIO.MINIO_ROOT_USER}}
# MINIO_ROOT_PASSWORD=${{MinIO.MINIO_ROOT_PASSWORD}}
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio.railway.internal
MINIO_PORT=9000
MINIO_BUCKET=nexly-files
MINIO_USE_SSL=false
MINIO_ROOT_USER=nexly_minio
MINIO_ROOT_PASSWORD=change-this-to-a-strong-password

# ==========================================
# Stripe Billing
# ==========================================

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FREE_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ==========================================
# Email Configuration
# ==========================================

# For AWS SES (production):
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@your-domain.com

# For SMTP:
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# ==========================================
# AI Provider (optional)
# ==========================================

# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1

# ==========================================
# pgAdmin Configuration (Debug profile only)
# ==========================================

PGADMIN_EMAIL=admin@nexly.local
PGADMIN_PASSWORD=change-this-password
