# Production Environment Configuration for MainTek
# Copy this file to .env and fill in your actual values
#
# Railway deployment:
#   DATABASE_URL and REDIS_URL are auto-injected by Railway plugins.
#   Set other vars as Railway service variables or shared variables.

# ==========================================
# Application Settings
# ==========================================

# Public URL where the application will be accessible
PUBLIC_URL=https://your-domain.com
PUBLIC_WEB_URL=https://your-domain.com

# Node environment — must be 'production' to enable prod validation/logging
NODE_ENV=production

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-change-this
BETTER_AUTH_URL=https://api.your-domain.com

# NOTE: Better Auth uses BETTER_AUTH_SECRET above — the old JWT_SECRET is no
# longer used and has been removed.

# CORS — comma-separated list of allowed web origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==========================================
# Database Configuration
# ==========================================

# Railway: DATABASE_URL is auto-injected — no need to set these individually.
# Docker/self-hosted: set individual vars below.
# DATABASE_URL=postgresql://user:pass@host:5432/maintek
POSTGRES_USER=maintek
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=maintek
DB_SSL=true

# ==========================================
# Redis Configuration
# ==========================================

# Railway: REDIS_URL is auto-injected — no need to set these individually.
# Docker/self-hosted: set individual vars below.
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-to-a-strong-password

# ==========================================
# Default Tenant / User (single shared workspace, no auth)
# ==========================================

# These seed and identify the single shared tenant + user the app runs as.
# Generate fresh UUIDs for production with: uuidgen
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002
DEFAULT_USER_EMAIL=admin@your-domain.com

APP_BASE_URL=https://your-domain.com

# ==========================================
# Storage Configuration
# ==========================================

# For AWS S3 (production):
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=your-maintek-files-bucket

# For MinIO on Railway private networking:
# Create a MinIO service in the same Railway environment, attach a volume,
# and set the API service vars roughly like:
# STORAGE_PROVIDER=minio
# MINIO_ENDPOINT=${{MinIO.RAILWAY_PRIVATE_DOMAIN}}
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_BUCKET=maintek-files
# MINIO_ROOT_USER=${{MinIO.MINIO_ROOT_USER}}
# MINIO_ROOT_PASSWORD=${{MinIO.MINIO_ROOT_PASSWORD}}
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio.railway.internal
MINIO_PORT=9000
MINIO_BUCKET=maintek-files
MINIO_USE_SSL=false
MINIO_ROOT_USER=maintek_minio
MINIO_ROOT_PASSWORD=change-this-to-a-strong-password

# Public URL the browser uses to fetch presigned files (must be reachable from
# end users; typically a CDN or the public MinIO endpoint, not the private one).
MINIO_PUBLIC_URL=https://files.your-domain.com

# ==========================================
# Billing
# ==========================================
# The payment gateway (Polar.sh) has been removed — Maintek is free, every
# feature is available to every org, and there is no checkout/trial/suspend
# flow. This var is retained as a no-op switch: the BILLING_ENFORCED guards
# in jwt-auth.guard.ts / feature-gate.guard.ts only activate when it is
# 'true', and there is no payment provider wired to back that anymore.
BILLING_ENFORCED=false

# ==========================================
# OAuth Social Providers (optional — leave blank to disable)
# ==========================================

# Google: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple: https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=com.maintek.app

# ==========================================
# Sentry Error Tracking (optional — leave blank to disable)
# ==========================================

# Create a project at https://sentry.io and copy the DSN.
# Separate DSNs per app are recommended so events route to the right project.
SENTRY_DSN=                          # API (server)
NEXT_PUBLIC_SENTRY_DSN=              # Web (browser + server, exposed to client)
EXPO_PUBLIC_SENTRY_DSN=              # Mobile (Expo)
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# Email Configuration
# ==========================================

# NOTE: Email verification on sign-up is intentionally DISABLED for launch.

# Resend (transactional email — scheduled reports, etc.)
# Get from https://resend.com/api-keys
RESEND_API_KEY=
# Default From address for outbound email (must be a verified Resend sender)
EMAIL_FROM=noreply@your-domain.com

# For AWS SES (production):
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@your-domain.com

# For SMTP:
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# ==========================================
# AI Provider (optional — assistant degrades gracefully if unset)
# ==========================================

# Easiest hosted option: Anthropic (Claude). Set the key and the API
# auto-selects it; incurs per-use Claude API cost.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Or AWS Bedrock (Claude via your AWS account):
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1

# Or a self-hosted Ollama server (must be reachable from the API):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://your-ollama-host:11434
# OLLAMA_MODEL=llama3.2

# ==========================================
# pgAdmin Configuration (Debug profile only)
# ==========================================

PGADMIN_EMAIL=admin@maintek.local
PGADMIN_PASSWORD=change-this-password
