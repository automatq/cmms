# Production Environment Configuration for CMMS
# Copy this file to .env and fill in your actual values

# ==========================================
# Application Settings
# ==========================================

# Public URL where the application will be accessible
PUBLIC_URL=https://your-domain.com

# JWT Secret for API authentication (generate a strong random string)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==========================================
# Database Configuration
# ==========================================

POSTGRES_USER=cmms
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=cmms

# ==========================================
# Clerk Configuration
# ==========================================

CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# ==========================================
# Storage Configuration
# ==========================================

# For AWS S3 (production):
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=your-cmms-files-bucket

# For MinIO (self-hosted):
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=cmms_minio
MINIO_ROOT_PASSWORD=change-this-to-a-strong-password

# ==========================================
# Stripe Billing
# ==========================================

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FREE_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ==========================================
# Email Configuration
# ==========================================

# For AWS SES (production):
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@your-domain.com

# For SMTP:
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# ==========================================
# AI Provider (optional)
# ==========================================

# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1

# ==========================================
# pgAdmin Configuration (Debug profile only)
# ==========================================

PGADMIN_EMAIL=admin@cmms.local
PGADMIN_PASSWORD=change-this-password
