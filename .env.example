# App
PUBLIC_URL=http://localhost
JWT_SECRET=change-me-to-a-random-64-char-string

# Postgres
POSTGRES_USER=maintek
POSTGRES_PASSWORD=maintek_secret
POSTGRES_DB=maintek

# Redis
REDIS_PASSWORD=redis_secret

# Default tenant/user (single shared workspace, no auth)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002
DEFAULT_USER_EMAIL=admin@local

# MinIO (local dev storage)
MINIO_ROOT_USER=maintek_minio
MINIO_ROOT_PASSWORD=minio_secret
MINIO_BUCKET=maintek-files

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# pgAdmin (debug profile only)
PGADMIN_EMAIL=admin@maintek.local
PGADMIN_PASSWORD=pgadmin_secret
