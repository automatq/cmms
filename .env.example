# App
PUBLIC_URL=http://localhost
# Public hostname for automatic HTTPS via Caddy (e.g. maintek.example.com).
# Leave empty for plain HTTP on localhost. When set, PUBLIC_URL must be https://<SITE_ADDRESS>.
SITE_ADDRESS=

# Better Auth — REQUIRED. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres
POSTGRES_USER=maintek
POSTGRES_PASSWORD=maintek_secret
POSTGRES_DB=maintek

# Redis
REDIS_PASSWORD=redis_secret

# MinIO (local dev storage)
MINIO_ROOT_USER=maintek_minio
MINIO_ROOT_PASSWORD=minio_secret
MINIO_BUCKET=maintek-files

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# pgAdmin (debug profile only)
PGADMIN_EMAIL=admin@maintek.local
PGADMIN_PASSWORD=pgadmin_secret
