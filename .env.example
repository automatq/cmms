# App
PUBLIC_URL=http://localhost
JWT_SECRET=change-me-to-a-random-64-char-string

# Postgres
POSTGRES_USER=cmms
POSTGRES_PASSWORD=cmms_secret
POSTGRES_DB=cmms

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.cmms.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# MinIO (local dev storage)
MINIO_ROOT_USER=cmms_minio
MINIO_ROOT_PASSWORD=minio_secret

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# pgAdmin (debug profile only)
PGADMIN_EMAIL=admin@cmms.local
PGADMIN_PASSWORD=pgadmin_secret
